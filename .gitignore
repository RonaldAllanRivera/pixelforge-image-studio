.env
.env.backup
.env.production
.env.*.local
auth.json

# Test output
/.phpunit.cache
.phpunit.result.cache
/coverage
/tests/Browser/Screenshots
/test-results
/playwright-report

# Logs
*.log
npm-debug.log*
yarn-error.log*

# Editors, tools and OS files
/.idea
/.vscode
/.fleet
/.nova
/.zed
.phpactor.json
Homestead.json
Homestead.yaml
.claude/settings.local.json
.DS_Store
